# EduMentor AI Environment Configuration

# Application
PROJECT_NAME="EduMentor AI — Adaptive AI Teacher"
VERSION="1.0.0"
API_V1_STR="/api"
DEBUG=true
SECRET_KEY="edumentor-super-secure-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# PostgreSQL (Production): postgresql://postgres:postgres@localhost:5432/edumentor
# SQLite (Development zero-config fallback): sqlite:///./edumentor.db
DATABASE_URL="sqlite:///./edumentor.db"
# MongoDB Atlas (Cloud NoSQL & Tenant Sync):
MONGODB_URL="mongodb+srv://cpriyansu8_db_user:3fPROaia4QVnmWd4@cluster0.u7ive4r.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="edumentor_db"

# AI Provider Configuration
# Options: "openai", "gemini", "groq", "mock"
LLM_PROVIDER="mock"
LLM_MODEL="gemini-2.0-flash"
LLM_API_KEY=""

# Embeddings Configuration
# Options: "local", "openai", "mock"
EMBEDDING_PROVIDER="local"
EMBEDDING_MODEL="BAAI/bge-m3"
EMBEDDING_DIM=384

# Multimodal Providers
STT_PROVIDER="webspeech"
TTS_PROVIDER="webspeech"
TTS_API_KEY=""
AVATAR_PROVIDER="canvas"
AVATAR_API_KEY=""

# Document Storage
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_SIZE_MB=25

# CORS Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
