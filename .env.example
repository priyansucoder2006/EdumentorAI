# EduMentorAI Configuration Example
PROJECT_NAME="EduMentor AI — Adaptive AI Teacher"
VERSION="1.0.0"
API_V1_STR="/api"
DEBUG=true
SECRET_KEY="change-me-to-a-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./edumentor.db"
MONGODB_URL=""
MONGODB_DB_NAME="edumentor_db"

# LLM Providers (Groq, OpenAI, Gemini, Mock)
LLM_PROVIDER="groq"
LLM_MODEL="openai/gpt-oss-120b"
GROQ_API_KEY=""
LLM_API_KEY=""

# Embeddings
EMBEDDING_PROVIDER="local"
EMBEDDING_MODEL="BAAI/bge-m3"
EMBEDDING_DIM=384

# Self-Hosted Judge0 Code Execution (No API key required for self-hosted setup)
JUDGE0_API_URL="http://localhost:2358"

# YouTube Data API v3 (For duration-aware learning video recommendations)
YOUTUBE_API_KEY=""

# Multimodal Providers (Optional)
STT_PROVIDER="webspeech"
TTS_PROVIDER="webspeech"
AVATAR_PROVIDER="canvas"
VIDEO_ENGINE="fast_local"
D_ID_API_KEY=""
HEYGEN_API_KEY=""
ELEVENLABS_API_KEY=""

# Storage
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_SIZE_MB=25
